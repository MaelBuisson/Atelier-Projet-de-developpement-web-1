# Modèle de configuration de l'API : copier en config/.env et compléter
# (mêmes identifiants que POSTGRES_USER / POSTGRES_PASSWORD dans nrv.env)
DRIVER=pgsql
HOST=nrv.db
DATABASE=nrv
USERNAME=
PASSWORD=

# true en développement : les erreurs internes (500) renvoient leur message détaillé
DISPLAY_ERROR_DETAILS=false
